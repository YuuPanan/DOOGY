# These values are public in the installed app. Never put tokens, passwords or vendor keys here.
# Real phone: the backend computer's LAN address; Android emulator: http://10.0.2.2:3000
EXPO_PUBLIC_CN_API_URL=http://192.168.1.10:3000
EXPO_PUBLIC_GLOBAL_API_URL=
# npm scripts use development/preview by default. Production requires HTTPS region URLs.
# Build variant is read from the shell before Expo loads .env:
# PowerShell: $env:APP_VARIANT = 'production'
# Native build tools are selected in the terminal, not Expo public variables:
# Set JAVA_HOME (JDK 17) and ANDROID_HOME (SDK 37) in your terminal; see docs/android-toolchain.md.
# Sets process-only JAVA_HOME/ANDROID_HOME/ANDROID_SDK_ROOT/GRADLE_USER_HOME and UTF-8.
# See docs/android-toolchain.md; keep existing .env values unchanged.
# apk:android builds an isolated arm64 preview APK without reading/copying .env files.
# Optional public API URLs must be set in that build terminal, or entered in the app.
# See docs/android-apk.md for the test signature and API connection requirements.
