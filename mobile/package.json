{
  "name": "doogy-mobile",
  "version": "0.1.3",
  "main": "index.ts",
  "dependencies": {
    "@expo/metro-runtime": "~58.0.17",
    "@react-navigation/bottom-tabs": "^7.22.0",
    "@react-navigation/native": "^7.5.2",
    "@react-navigation/native-stack": "^7.21.1",
    "expo": "~58.0.26",
    "expo-audio": "~58.0.12",
    "expo-clipboard": "~58.0.4",
    "expo-crypto": "~58.0.8",
    "expo-dev-client": "~58.0.21",
    "expo-document-picker": "~58.0.5",
    "expo-file-system": "~58.0.14",
    "expo-image-picker": "~58.0.10",
    "expo-secure-store": "~58.0.3",
    "expo-sharing": "~58.0.23",
    "expo-status-bar": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "expo-video": "~58.0.14",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "react-test-renderer": "19.3.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "node scripts/expo.cjs start --dev-client",
    "android": "node scripts/expo.cjs run:android",
    "apk:android": "node scripts/build-android.cjs",
    "apk:android:qa": "node scripts/build-android.cjs --qa",
    "ios": "node scripts/expo.cjs run:ios",
    "web": "node scripts/expo.cjs start --web",
    "prebuild:android": "node scripts/expo.cjs prebuild --platform android --no-install",
    "bundle:android": "node scripts/expo.cjs export --platform android --output-dir dist-android",
    "bundle:ios": "node scripts/expo.cjs export --platform ios --output-dir dist-ios",
    "bundle:web": "node scripts/expo.cjs export --platform web --output-dir dist-web",
    "check": "tsc --noEmit",
    "test": "npm --prefix .. run build && tsc -p tsconfig.test.json && node --test test/*.test.cjs"
  },
  "private": true
}
