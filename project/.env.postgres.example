PORT=3002
HOST=127.0.0.1
DATA_MODE=offline
# Interpretation/assistant jobs: offline is a labelled fixed demo; api fails MODEL_NOT_CONFIGURED until a provider contract is implemented. No model keys are used yet.
# Password recovery: offline local delivery uses recovery:deliver; api reports not_configured. No email provider or mail keys are used.
# Contact alerts: Worker simulates message-only results offline; api fails CHANNEL_NOT_CONFIGURED. No SMS/email calls or automatic location links.
# Content catalog has no automatic seed or external fetch. Use start.bat env-file content-import catalog.json for maintained content.
# Managed backups use the selected PostgreSQL source and existing PG_TOOLS; automatic checks are disabled until enabled.
MANAGED_BACKUP_ENABLED=false
MANAGED_BACKUP_DIRECTORY=./data/managed-backups
MANAGED_BACKUP_KEEP_COUNT=7
MANAGED_BACKUP_INTERVAL_HOURS=24
# Account export uses a temporary DOOGY_ACCESS_TOKEN shell variable; do not store it in this file.
# Retention is disabled per household until its owner enables the API policy; see docs/privacy-lifecycle.md.
# Inventory retention is separately disabled until a device admin enables its API policy; see docs/inventory-retention.md.
# Restore deletion/care-withdrawal replay requires DATA_MODE=offline and a separate restored database configuration.
DB_DRIVER=postgres
# Local development credentials only. Change them for any shared deployment.
DATABASE_URL=postgresql://doogy:doogy-local-dev@127.0.0.1:55432/doogy
# Backup/restore tools: docker uses this project's Compose service; native uses PATH pg_dump/pg_restore.
PG_TOOLS=docker
# Source SQLite file for the explicit one-time import; never used as a fallback.
DB_PATH=./data/doogy.db
FRESH_SECONDS=300
OFFLINE_SECONDS=300
LOW_BATTERY_PCT=20
# Maximum business idempotency cache lifetime, including care edits/withdrawals; replay never extends it. Worker cleans expired rows each minute.
IDEMPOTENCY_TTL_HOURS=24
# Optional directory with ffmpeg/ffprobe; defaults to project .tools/media. Missing tools disable media uploads.
# MEDIA_TOOLS_DIRECTORY=E:/tools/ffmpeg/bin
SUPPORT_ADMIN_USER_IDS=
DEVICE_ADMIN_USER_IDS=
